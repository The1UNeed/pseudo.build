{
  "name": "pseudoeditor.dev",
  "version": "0.1.9",
  "private": true,
  "description": "PseudoEditor website and browser Pseudocode Compiler app.",
  "author": "Alex",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm --filter @pseudoeditor/web dev",
    "dev:web": "pnpm --filter @pseudoeditor/web dev",
    "build": "pnpm --filter @pseudoeditor/web build",
    "test": "pnpm -r --if-present run test",
    "test:compiler": "pnpm --filter @igcse/compiler test",
    "test:web": "pnpm --filter @pseudoeditor/web test",
    "build:runtime": "./scripts/build-runtime-wasm.sh",
    "test:runtime": "cargo test -p pseudocode-runtime",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint"
  },
  "devDependencies": {
    "convex": "^1.36.1",
    "next": "16.2.9"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "^7.29.6",
      "dompurify": "^3.4.11",
      "js-cookie": "^3.0.7",
      "minimatch@^3.0.0": "3.1.4",
      "minimatch@^9.0.0": "9.0.7",
      "minimatch@^10.0.0": "10.2.3",
      "postcss": "^8.5.10",
      "rollup": "^4.59.0",
      "ws": "^8.21.0"
    },
    "onlyBuiltDependencies": [
      "dtrace-provider",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
