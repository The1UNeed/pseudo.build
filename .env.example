# Pseudo Build environment variables. Names and placeholders only; never commit real values.
# Local development: copy to apps/web/.env.local. Accounts and cloud sync are optional on localhost.

# --- Web app (apps/web/.env.local locally, Vercel project settings in production) ---

# Clerk publishable key. Set in Vercel.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
# Clerk secret key, used by the /api/workspace route. Set in Vercel.
CLERK_SECRET_KEY=sk_test_placeholder
# Convex deployment URL. Written by `npx convex dev` locally; injected by `convex deploy` in the Vercel build.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Convex deployment name. Written by `npx convex dev` locally; not needed in Vercel.
CONVEX_DEPLOYMENT=
# Optional server-side Convex URL override (falls back to NEXT_PUBLIC_CONVEX_URL). Set in Vercel if needed.
CONVEX_URL=
# Convex deploy key used by scripts/vercel-build.sh. Set in Vercel, scoped per environment
# (production key for Production only, a preview key for Preview).
CONVEX_DEPLOY_KEY=preview:placeholder

# --- Convex functions (Convex dashboard > Settings > Environment Variables, not Vercel) ---

# Clerk Frontend API URL, used by convex/auth.config.ts. Set in the Convex dashboard.
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# Signing secret of the Clerk user.deleted webhook, used by convex/http.ts. Set in the Convex dashboard.
CLERK_WEBHOOK_SECRET=whsec_placeholder
