  "description": "Next.js browser app and website for Pseudo Build.",
  "author": "Alex",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "cross-env NEXT_PUBLIC_RESET_WORKSPACE_ON_DEV=1 next dev",
