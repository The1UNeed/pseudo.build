{
  "name": "@pseudobuild/compiler",
  "version": "0.1.9",
  "private": true,
  "description": "Pseudocode compiler core — tokenizer, parser, semantics, and AST generation.",
  "license": "GPL-3.0-only",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
